node_modules/
*.log
tests/gate-results.json
.env
.DS_Store
# Third-party skill content is fetched here at run time and MUST NOT be committed
# (see scripts/fetch-skills.js + suites/manifest.json). The publish tree never
# contains third-party SKILL.md text.
/.skills-workdir/
# Emitted receipts are build artifacts by default; keep the dir, ignore contents
# except an explicit .gitkeep and any receipts a user chooses to force-add.
/receipts/*.json
/receipts/*.md
!/receipts/.gitkeep
# Retained transcripts (--keep-transcripts) are raw model text; never committed.
/transcripts/
# Release-trigger state: the seen-models file and last-run markers.
/state/
# Auto-prepared DRAFT reports (release trigger). Never tracked, never published:
# a sitting unreviewed draft must not ride along with an unrelated publish. On
# approval they are promoted OUT of *-draft/ (see RUNBOOK.md), which un-ignores them.
/docs/reports/*-draft/
/receipts/report-*-draft/
