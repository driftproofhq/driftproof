{
  "name": "driftproof",
  "version": "0.8.0",
  "description": "A dated proof that this skill, this hash, this model, still helps: run a skill's eval suite with and without the skill across model versions, emit hash-verified dated receipts, and diff receipts into drift reports.",
  "license": "Apache-2.0",
  "keywords": [
    "agent-skills",
    "skill-md",
    "skill-eval",
    "llm-evaluation",
    "claude-code",
    "drift",
    "receipts"
  ],
  "homepage": "https://driftproofhq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/driftproofhq/driftproof.git"
  },
  "bugs": {
    "url": "https://github.com/driftproofhq/driftproof/issues"
  },
  "bin": {
    "driftproof": "bin/driftproof"
  },
  "files": [
    "bin/",
    "lib/",
    "spec/",
    "config.js",
    "config/models.json"
  ],
  "scripts": {
    "gate": "node tests/gate.js",
    "run": "node bin/driftproof run",
    "diff": "node bin/driftproof diff"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.39.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "html-validate": "^11.11.0"
  }
}
